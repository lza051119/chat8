# Whisper 客户端环境配置

# 开发环境配置（本地同域访问，避免跨域）
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/ws
VITE_DEBUG=true
VITE_LOG_LEVEL=debug

# 应用配置
VITE_APP_NAME=Whisper
VITE_APP_VERSION=1.0.0

# 加密配置
VITE_ENCRYPTION_ENABLED=true
VITE_LOCAL_STORAGE_ENCRYPTION=true

# 文件上传配置
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/*,text/*,application/pdf

# 消息配置
VITE_MESSAGE_RETENTION_DAYS=30
VITE_AUTO_DELETE_MESSAGES=false